{
  "manifest_version": 3,
  "name": "YouTube Glass",
  "version": "1.0.0",
  "description": "Give YouTube a frosted glass finish with soft colors, translucent panels, and adjustable blur.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "YouTube Glass",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["theme.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
